# ---------------------------------------------------------------------------
# Foremen DEV — secrets TEMPLATE.
#
# HOW TO USE
#   1. Copy this file to a local, git-ignored copy:
#        cp secrets.template.env secrets.local.env
#   2. Fill in the values in secrets.local.env (right-hand side of each =).
#   3. Load them into Secret Manager:
#        ./21-load-secrets.sh secrets.local.env
#   4. DELETE the local copy when done (it holds plaintext secrets):
#        shred -u secrets.local.env    # or: rm -P secrets.local.env (macOS)
#
# RULES
#   - NEVER commit the filled-in copy. `.gitignore` already ignores *.env.local
#     and .env; name your copy `secrets.local.env` and it is covered too (add it
#     if you pick another name).
#   - Leave a value BLANK to let the loader auto-generate a strong random value
#     (recommended for DB_PASSWORD, JWT_SECRET, ADMIN_PASSWORD).
#   - Values are read literally; do NOT wrap them in quotes.
# ---------------------------------------------------------------------------

# --- REQUIRED: core app secrets (blank => auto-generated) ---
# Database password for the 'foremen' Postgres user.
DB_PASSWORD=
# JWT signing secret for the backend (base64-ish, >= 32 bytes of entropy).
JWT_SECRET=
# Password for the first ADMIN account the backend bootstraps on startup.
ADMIN_PASSWORD=

# --- OPTIONAL: outbound email (leave blank to keep mail disabled in dev) ---
# SMTP account used to send invites / password resets / notifications.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- OPTIONAL: Google integrations (leave blank to keep disabled in dev) ---
# Google Places API key (address autocomplete). Use a SEPARATE dev-scoped key,
# not the production one, and restrict it in the Google Cloud console.
GOOGLE_PLACES_API_KEY=
# Google OAuth client id used to verify client "Sign in with Google" tokens.
GOOGLE_OAUTH_CLIENT_ID=
