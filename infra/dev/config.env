# ---------------------------------------------------------------------------
# Foremen DEV infrastructure — shared configuration for all infra/dev scripts.
# Edit values here, then run the numbered scripts in order. Everything else
# derives from these. No secrets live in this file (secrets go to Secret
# Manager via 20-secrets.sh and are pulled onto the VM at boot).
# ---------------------------------------------------------------------------

# --- GCP target ---
export PROJECT_ID="starry-tracker-505110-s3"
export REGION="europe-central2"
export ZONE="europe-central2-a"

# --- VM ---
export VM_NAME="foremen-dev"
export MACHINE_TYPE="e2-small"          # 2 vCPU (shared) / 2 GB RAM
export BOOT_DISK_SIZE="20GB"
export BOOT_DISK_TYPE="pd-balanced"
export IMAGE_FAMILY="debian-12"
export IMAGE_PROJECT="debian-cloud"

# --- Networking ---
export STATIC_IP_NAME="foremen-dev-ip"
export FIREWALL_TAG="foremen-dev"
# Which inbound TCP ports to open to the world (0.0.0.0/0). The frontend
# container publishes port 80; add 8080 only if you also want the backend
# reachable directly (not required — the frontend proxies /api -> backend).
export OPEN_PORTS="80"

# --- Application images (Artifact Registry) ---
export AR_REPO="foremen"
export AR_HOST="${REGION}-docker.pkg.dev"
export IMAGE_BACKEND="${AR_HOST}/${PROJECT_ID}/${AR_REPO}/backend:dev"
export IMAGE_FRONTEND="${AR_HOST}/${PROJECT_ID}/${AR_REPO}/frontend:dev"

# --- Database (Postgres container ON the VM — the cheap option) ---
# To switch to managed Cloud SQL instead, see 15-cloud-sql.optional.sh.
export DB_NAME="foremen"
export DB_USER="foremen"
export DB_CONTAINER_PORT="5432"         # internal to the VM's docker network

# --- Service account for the VM ---
export VM_SA_NAME="foremen-dev-vm"
export VM_SA_EMAIL="${VM_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

# --- Secret Manager secret names ---
export SECRET_DB_PASSWORD="foremen-dev-db-password"
export SECRET_JWT="foremen-dev-jwt-secret"
export SECRET_ADMIN_PASSWORD="foremen-dev-admin-password"
# Optional secrets (loaded by 21-load-secrets.sh only if you provide values)
export SECRET_MAIL_USERNAME="foremen-dev-mail-username"
export SECRET_MAIL_PASSWORD="foremen-dev-mail-password"
export SECRET_GOOGLE_PLACES_KEY="foremen-dev-google-places-key"
export SECRET_GOOGLE_OAUTH_CLIENT="foremen-dev-google-oauth-client"

# --- First admin bootstrap (created by the backend on first start) ---
export ADMIN_EMAIL="cto+dev@loaders.dev"

# --- Optional: auto start/stop schedule to save money (used by 60-schedule.optional.sh)
# Cron-style, VM local time. Leave as-is; the schedule script is opt-in.
export START_SCHEDULE="0 8 * * MON-FRI"
export STOP_SCHEDULE="0 20 * * MON-FRI"
