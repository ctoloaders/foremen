# Telegram
TELEGRAM_BOT_TOKEN=              # Token from @BotFather
TELEGRAM_WEBHOOK_SECRET=         # Secret for webhook URL verification

# Google Service Account
GOOGLE_SERVICE_ACCOUNT_JSON=     # Path to JSON key file (relative to project root)

# Google Sheets - Registry
REGISTRY_SPREADSHEET_ID=         # ID of the registry spreadsheet (projects, workers, bot_state)
PROJECTS_SHEET_NAME=projects     # Sheet name for projects registry
WORKERS_SHEET_NAME=workers       # Sheet name for workers registry
ACCESS_SHEET_NAME=project_access # Sheet name for project access bindings
BOT_STATE_SHEET_NAME=bot_state   # Sheet name for bot conversation state

# Apps Script Webhook
APPS_SCRIPT_WEBHOOK_SECRET=      # Shared secret for validating incoming webhooks from Bitrix24

# Cloud Function (for deploy)
GCP_PROJECT_ID=                  # Google Cloud Project ID
GCP_REGION=me-west1              # Region (closest to Israel)
FUNCTION_NAME=receipt-bot        # Cloud Function name
