# Telegram
TELEGRAM_BOT_TOKEN=              # Token from @BotFather
TELEGRAM_WEBHOOK_SECRET=         # Secret for webhook URL verification

# Google Service Account
GOOGLE_SERVICE_ACCOUNT_JSON=     # Path to JSON key file (relative to project root)

# Google Sheets - Registry
WORKERS_SPREADSHEET_ID=          # ID of workers registry spreadsheet (workers, project_access, bot_state)
PROJECTS_SPREADSHEET_ID=         # ID of projects registry spreadsheet
ESTIMATES_FOLDER_ID=             # ID of test project folder (for legacy, can match PROJECTS_PARENT_FOLDER_ID)

# Google Shared Drive
SHARED_DRIVE_ID=                 # ID of the Shared Drive (Team Drive)
PROJECTS_PARENT_FOLDER_ID=       # ID of "Проекты" folder inside Shared Drive

# Sheet names (usually don't change)
WORKERS_SHEET_NAME=workers
ACCESS_SHEET_NAME=project_access
BOT_STATE_SHEET_NAME=bot_state
PROJECTS_SHEET_NAME=projects

# Apps Script / Webhook secret
APPS_SCRIPT_WEBHOOK_SECRET=      # Shared secret for validating incoming webhooks from Bitrix24

# Cloud Function (for deploy)
GCP_PROJECT_ID=                  # Google Cloud Project ID
GCP_REGION=me-west1              # Region (closest to Israel)
FUNCTION_NAME=receipt-bot        # Cloud Function name

# Bitrix24 field codes (different per client — get via crm.deal.fields / user.fields)
BITRIX_DRIVE_URL_FIELD=          # CRM Deal field code for Google Drive URL (e.g. UF_CRM_1785938336262)
BITRIX_SHEETS_URL_FIELD=         # CRM Deal field code for Google Sheets URL (e.g. UF_CRM_1785938353178)
BITRIX_TELEGRAM_ID_FIELD=        # User profile field code for Telegram ID (e.g. UF_USR_1785937945029)
BITRIX_ROLE_FIELD=               # User profile field code for Bot Role (e.g. UF_USR_1785938002037)
