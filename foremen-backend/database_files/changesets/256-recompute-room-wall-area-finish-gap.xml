<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        FOR-05-02 Round 11 #2: the wall-area formula changed from
            perimeter x h - doors - windows - wallGap x h
        to
            (perimeter - finishGap) x h - doors - windows.
        The wall_area column is persisted, so existing CALCULATED values are moved to the new formula:
            new = max(0, old + (wall_gap - finish_gap) x ceiling_height)
        Manual values (wall_area_source = 'MANUAL') are untouched. Rooms without any gap are untouched.
        Runs once (the changeSet id is the guard).
    -->
    <changeSet id="256-recompute-room-wall-area-finish-gap" author="foremen">
        <sql>
            UPDATE rooms
               SET wall_area = GREATEST(0, wall_area + (COALESCE(wall_gap, 0) - COALESCE(finish_gap, 0)) * COALESCE(ceiling_height, 0))
             WHERE wall_area IS NOT NULL
               AND wall_area_source = 'CALCULATED'
               AND (COALESCE(wall_gap, 0) &lt;&gt; 0 OR COALESCE(finish_gap, 0) &lt;&gt; 0)
        </sql>
    </changeSet>
</databaseChangeLog>
