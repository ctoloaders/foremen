            <column name="active" valueBoolean="true"/>
        </insert>
    </changeSet>

    <!-- Insert Kategoria: Sanitariat / Сантехника -->
    <changeSet id="052-reseed-material-categories-sanitariat" author="foremen">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM material_categories WHERE code = 'sanitariat'</sqlCheck>
        </preConditions>

        <insert tableName="material_categories">
