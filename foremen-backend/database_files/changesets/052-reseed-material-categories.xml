        </insert>
    </changeSet>

    <!-- Insert Kategoria: Płytki / Плитка -->
    <changeSet id="052-reseed-material-categories-plytki" author="foremen">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM material_categories WHERE code = 'plytki'</sqlCheck>
        </preConditions>

        <insert tableName="material_categories">
            <column name="code" value="plytki"/>
            <column name="name_ru" value="Плитка"/>
