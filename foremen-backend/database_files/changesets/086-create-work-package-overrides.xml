<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        FOR-05-04 (Requirement 4): WorkPackageOverride — a (WorkItem, OfferPackage) pair's
        package membership flag and optional package override volume formula, sourced from
        Oferta!AL:AN. Replaces the retired per-package price row as the "this work behaves
        differently in package X" mechanism; carries no price (R4.5).

        Columns mirror WorkPackageOverrideEntity (design §Component 3):
          - work_item_id           : FK to work_items, NOT NULL; ON DELETE CASCADE (an owned
                                      catalog extension of the work, per design §ABAC —
                                      removing the work removes its package overrides).
          - offer_package_id       : FK to offer_packages, NOT NULL; ON DELETE RESTRICT (a
                                      package referenced by an override cannot be silently
                                      removed).
          - member                 : BOOLEAN NOT NULL DEFAULT TRUE — package membership flag
                                      (R4.1, R4.2).
          - override_source_text   : TEXT, NULLABLE — human-readable override formula source;
                                      nullable because flag-only membership (no override
                                      formula) is allowed (R4.1, R4.3).
          - override_parsed_ast    : JSONB, NULLABLE — the validated parsed override formula;
                                      present iff override_source_text is present.
        Plus the four BaseEntity audit columns.

        UNIQUE (work_item_id, offer_package_id): exactly one override row per pair (R4.1).

        Idempotent via tableExists + MARK_RAN.
    -->

    <changeSet id="086-create-work-package-overrides" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="work_package_overrides"/>
            </not>
        </preConditions>

        <createTable tableName="work_package_overrides">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="work_item_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="offer_package_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="member" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="override_source_text" type="TEXT"/>
            <column name="override_parsed_ast" type="JSONB"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <!-- Exactly one override row per (work item, offer package) pair (R4.1). -->
        <addUniqueConstraint
            constraintName="uk_wpo_work_package"
            tableName="work_package_overrides"
            columnNames="work_item_id, offer_package_id"/>

        <!-- OWNER FK: deleting the work item removes its package overrides (owned catalog
             extension, not an independent resource). -->
        <addForeignKeyConstraint
            constraintName="fk_wpo_work_item"
            baseTableName="work_package_overrides"
            baseColumnNames="work_item_id"
            referencedTableName="work_items"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <!-- Package reference FK: ON DELETE RESTRICT. -->
        <addForeignKeyConstraint
            constraintName="fk_wpo_offer_package"
            baseTableName="work_package_overrides"
            baseColumnNames="offer_package_id"
            referencedTableName="offer_packages"
            referencedColumnNames="id"
            onDelete="RESTRICT"/>
    </changeSet>

</databaseChangeLog>
