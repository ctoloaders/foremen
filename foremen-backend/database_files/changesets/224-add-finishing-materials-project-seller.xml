<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        FOR-11-00 (procurement foundation, R2.1): extend finishing_materials with
          - project_id: nullable FK to projects (NULL = global catalog material, set = project-only material)
          - seller_id:  nullable FK to material_sellers, ON DELETE SET NULL
        Every column, FK and index is its own changeSet, guarded so re-runs are no-ops (MARK_RAN).
        Registered in changelog.xml by a separate task.
    -->

    <!-- project_id -->
    <changeSet id="224-finishing-materials-add-project-id" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="finishing_materials" columnName="project_id"/></not>
        </preConditions>
        <addColumn tableName="finishing_materials">
            <column name="project_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="224-finishing-materials-project-fk" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyTableName="finishing_materials" foreignKeyName="fk_finishing_materials_project"/></not>
        </preConditions>
        <addForeignKeyConstraint
            constraintName="fk_finishing_materials_project"
            baseTableName="finishing_materials"
            baseColumnNames="project_id"
            referencedTableName="projects"
            referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="224-finishing-materials-project-idx" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="finishing_materials" indexName="idx_finishing_materials_project"/></not>
        </preConditions>
        <createIndex tableName="finishing_materials" indexName="idx_finishing_materials_project">
            <column name="project_id"/>
        </createIndex>
    </changeSet>

    <!-- seller_id -->
    <changeSet id="224-finishing-materials-add-seller-id" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="finishing_materials" columnName="seller_id"/></not>
        </preConditions>
        <addColumn tableName="finishing_materials">
            <column name="seller_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="224-finishing-materials-seller-fk" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyTableName="finishing_materials" foreignKeyName="fk_finishing_materials_seller"/></not>
        </preConditions>
        <addForeignKeyConstraint
            constraintName="fk_finishing_materials_seller"
            baseTableName="finishing_materials"
            baseColumnNames="seller_id"
            referencedTableName="material_sellers"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="224-finishing-materials-seller-idx" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="finishing_materials" indexName="idx_finishing_materials_seller"/></not>
        </preConditions>
        <createIndex tableName="finishing_materials" indexName="idx_finishing_materials_seller">
            <column name="seller_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
