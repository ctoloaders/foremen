    <!--
        FOR-05-04-UI: seed assortment_groups + assortment_line_items from the
        "Materiały pakiety" catalog (docs/Materiały pakiety - Lista.csv).

        Groups mirror the CSV Kategoria column; line items are one curated row per
        (offer package x group) with min/avg/max derived from the per-variant net
        price (Cena detal netto, fallback Cena detal / m2 -> Cena detal brutto).
        CSV package tokens Budget/Standard(=Standart)/Lux map to offer_packages
        codes budget/norm/lux. qty_ref50 defaults to 1.0000 (the source 50/m2
        quantity columns are empty in this export).

        Idempotent: each changeSet is guarded by an onFail="MARK_RAN" precondition,
        so a re-run against an already-seeded database inserts nothing. The line-item
        inserts resolve group/package FKs by their natural code via valueComputed
        subselects, so they do not depend on surrogate id ordering.
    -->

    <changeSet id="091-seed-assortment-groups" author="foremen">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM assortment_groups</sqlCheck>
        </preConditions>
        <insert tableName="assortment_groups">
            <column name="name_ru" value="Пол"/>
            <column name="name_pl" value="Podłoga"/>
            <column name="sort_order" valueNumeric="10"/>
            <column name="created_by" value="system"/>
        </insert>
        <insert tableName="assortment_groups">
            <column name="name_ru" value="Плинтусы"/>
            <column name="name_pl" value="Listwy przypodłogowe"/>
            <column name="sort_order" valueNumeric="20"/>
            <column name="created_by" value="system"/>
        </insert>
        <insert tableName="assortment_groups">
            <column name="name_ru" value="Плитка"/>
            <column name="name_pl" value="Płytki"/>
            <column name="sort_order" valueNumeric="30"/>
            <column name="created_by" value="system"/>
        </insert>
        <insert tableName="assortment_groups">
            <column name="name_ru" value="Сантехника"/>
            <column name="name_pl" value="Sanitariat"/>
            <column name="sort_order" valueNumeric="40"/>
            <column name="created_by" value="system"/>
        </insert>
        <insert tableName="assortment_groups">
            <column name="name_ru" value="Двери"/>
            <column name="name_pl" value="Drzwi"/>
            <column name="sort_order" valueNumeric="50"/>
            <column name="created_by" value="system"/>
        </insert>
    </changeSet>

