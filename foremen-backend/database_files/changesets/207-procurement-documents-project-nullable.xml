<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        FOR-07-03 (Requirements 1.1, 3.1, 14.1): company-level procurement documents have no
        project, so procurement_documents.project_id drops its NOT NULL constraint. The FK to
        projects (ON DELETE CASCADE) and ix_procurement_documents_project are kept untouched.
        Idempotent: guarded by a sqlCheck that the column is still NOT NULL + onFail="MARK_RAN".
    -->
    <changeSet id="207-procurement-documents-project-nullable" author="foremen">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="procurement_documents"/>
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM information_schema.columns
                WHERE table_schema = current_schema()
                  AND table_name = 'procurement_documents'
                  AND column_name = 'project_id'
                  AND is_nullable = 'NO'
            </sqlCheck>
        </preConditions>
        <dropNotNullConstraint tableName="procurement_documents"
                               columnName="project_id"
                               columnDataType="BIGINT"/>
    </changeSet>
</databaseChangeLog>
