<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        FOR-06-11 (Requirements 1.3, 6.1): the paid-by marker on the FOR-06-01 work_report_rooms
        report line (changeset 164) — the single additive migration that lets payroll record which
        report lines a regular WorkerPayout paid, WITHOUT a copy table and WITHOUT a new WorkReport
        status (design §Data Models). The FOR-06-01 status machine is unchanged (R6.1).

        Adds a nullable paid_by_payout_id BIGINT to work_report_rooms with an FK ->
        worker_payouts(id) (changeset 180) ON DELETE SET NULL: a line is PAID iff the FK is set,
        PAYABLE iff null. The FK is set on every covered unpaid APPROVED line within a regular
        payout's create transaction and cleared when that PLANNED payout is deleted; ON DELETE SET
        NULL is only a DB-level safety net, since in practice the FK is always cleared explicitly in
        the payout-delete transaction (R6.3). The column is nullable — every existing and every
        unpaid line stays NULL; there is no backfill.

        No new WorkReport status, no FOR-06-01 state-machine change.

        Idempotent via NOT columnExists + onFail="MARK_RAN" (mirrors the add-column + FK style of
        changeset 170), so a re-run against an already-migrated database makes no schema change
        (R1.3). Registered LAST in changelog.xml, after 180 (the FK target table).
    -->

    <changeSet id="181-add-work-report-room-paid-by-payout" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="work_report_rooms" columnName="paid_by_payout_id"/>
            </not>
        </preConditions>

        <addColumn tableName="work_report_rooms">
            <column name="paid_by_payout_id" type="BIGINT"/>
        </addColumn>

        <!-- Paid-by marker FK: nullable, ON DELETE SET NULL (R6.1, R6.3) — deleting a payout clears
             the paid-by linkage on any referencing line rather than cascading to the report line. -->
        <addForeignKeyConstraint
            constraintName="fk_work_report_rooms_paid_by_payout"
            baseTableName="work_report_rooms"
            baseColumnNames="paid_by_payout_id"
            referencedTableName="worker_payouts"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
