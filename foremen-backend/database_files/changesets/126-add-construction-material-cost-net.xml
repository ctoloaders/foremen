<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        FOR-05-06 (R3.1, R3.2, R3.3): material self-cost on construction_materials.

        Adds cost_net NUMERIC(12,2) NOT NULL DEFAULT 0 and back-fills it ONCE from the
        existing retail_net (cost_net = round(retail_net * 0.9, 2)) where retail_net is
        non-null; rows with a null retail_net keep the 0 default (sentinel, so the column
        stays NOT NULL). cost_net is independent of retail_net after this seed (it is not
        recomputed on retail edits — see the CRUD layer).

        126-add-...-column: the NOT NULL DEFAULT 0 add-column, guarded by NOT columnExists
          (a re-run against a migrated DB is MARK_RAN, no schema change).
        126-backfill-...: the one-shot back-fill, guarded so it only touches rows still at
          the 0 default AND with a non-null retail_net. On a fresh add every real row is 0,
          so it is back-filled; on a re-run (or after an admin edited cost_net away from a
          derived value) nothing that already has a non-zero cost is overwritten. The whole
          changeset is additionally MARK_RAN via a COUNT precondition so it runs at most once.
    -->

    <changeSet id="126-add-construction-material-cost-net-column" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="construction_materials" columnName="cost_net"/>
            </not>
        </preConditions>
        <addColumn tableName="construction_materials">
            <column name="cost_net" type="NUMERIC(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="126-backfill-construction-material-cost-net" author="foremen">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM construction_materials WHERE cost_net != 0
            </sqlCheck>
        </preConditions>
        <update tableName="construction_materials">
            <column name="cost_net" valueComputed="round(retail_net * 0.9, 2)"/>
            <where>retail_net IS NOT NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>
