<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- FOR-05-07 Batch 2 (task 8): custom offer name (free text) + immutable JSONB snapshot of the estimate
         captured when the offer is prepared. Both nullable: offers created before this change have no snapshot. -->
    <changeSet id="258-add-offers-name-and-snapshot" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="offers" columnName="snapshot"/>
            </not>
        </preConditions>
        <addColumn tableName="offers">
            <column name="name" type="VARCHAR(255)"/>
            <column name="snapshot" type="jsonb"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
