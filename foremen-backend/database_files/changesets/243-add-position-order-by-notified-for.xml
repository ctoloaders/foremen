<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        FOR-11-04 (task 1.3, R2.3, R14.2): one-shot guard for the "order-by date missed" notification.
        Stores the order_by_date for which the notification was already sent, so the sweep does not repeat it.
        Idempotent: columnExists guard + MARK_RAN. Registered LAST in changelog.xml, after 242.
    -->
    <changeSet id="243-add-position-order-by-notified-for" author="foremen">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="purchase_positions"/>
            <not>
                <columnExists tableName="purchase_positions" columnName="order_by_notified_for"/>
            </not>
        </preConditions>
        <addColumn tableName="purchase_positions">
            <column name="order_by_notified_for" type="DATE"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
