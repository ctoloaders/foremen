<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        FOR-11-00 (task 1.5; design "Data model"): procurement positions.
          - purchase_positions         : one row per material position of a project purchase
                                         (planned_delivery_date is system-owned, synced from
                                         purchase_requests.expected_delivery_date)
          - purchase_position_variants : history of retired material variants of a position
        Depends on purchase_requests (226).
        Idempotent: each changeset is guarded by NOT tableExists + onFail="MARK_RAN".
        Registered LAST in changelog.xml (task 1.7).
    -->
    <changeSet id="227-create-purchase-positions" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="purchase_positions"/></not>
        </preConditions>
        <createTable tableName="purchase_positions">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="sourcing_path" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(24)" defaultValue="PLANNED">
                <constraints nullable="false"/>
            </column>
            <column name="planned_material_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="actual_material_id" type="BIGINT"/>
            <column name="delivery_category_id" type="BIGINT"/>
            <column name="block_no" type="INT"/>
            <column name="quantity" type="NUMERIC(14,3)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ordered_quantity" type="NUMERIC(14,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="accepted_quantity" type="NUMERIC(14,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="planned_purchase_price" type="NUMERIC(14,2)"/>
            <column name="sale_price" type="NUMERIC(14,2)"/>
            <column name="actual_purchase_price" type="NUMERIC(14,2)"/>
            <column name="purchase_vat_rate_id" type="BIGINT"/>
            <column name="sale_vat_rate_id" type="BIGINT"/>
            <column name="delivery_cost_share" type="NUMERIC(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="need_by_date" type="DATE"/>
            <column name="order_by_date" type="DATE"/>
            <column name="decision_deadline" type="DATE"/>
            <column name="planned_delivery_date" type="DATE"/>
            <column name="purchase_request_id" type="BIGINT"/>
            <column name="estimate_reference_id" type="BIGINT"/>
            <column name="notes" type="VARCHAR(2000)"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_project"
            baseTableName="purchase_positions" baseColumnNames="project_id"
            referencedTableName="projects" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_planned_material"
            baseTableName="purchase_positions" baseColumnNames="planned_material_id"
            referencedTableName="finishing_materials" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_actual_material"
            baseTableName="purchase_positions" baseColumnNames="actual_material_id"
            referencedTableName="finishing_materials" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_delivery_category"
            baseTableName="purchase_positions" baseColumnNames="delivery_category_id"
            referencedTableName="delivery_categories" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_unit"
            baseTableName="purchase_positions" baseColumnNames="unit_id"
            referencedTableName="measurement_units" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_purchase_vat"
            baseTableName="purchase_positions" baseColumnNames="purchase_vat_rate_id"
            referencedTableName="vat_rates" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_sale_vat"
            baseTableName="purchase_positions" baseColumnNames="sale_vat_rate_id"
            referencedTableName="vat_rates" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_request"
            baseTableName="purchase_positions" baseColumnNames="purchase_request_id"
            referencedTableName="purchase_requests" referencedColumnNames="id" onDelete="SET NULL"/>
        <addForeignKeyConstraint constraintName="fk_purchase_positions_estimate_reference"
            baseTableName="purchase_positions" baseColumnNames="estimate_reference_id"
            referencedTableName="estimate_line_room_materials" referencedColumnNames="id" onDelete="SET NULL"/>
        <sql>ALTER TABLE purchase_positions ADD CONSTRAINT ck_purchase_positions_kind CHECK (kind = 'FINISHING')</sql>
        <sql>ALTER TABLE purchase_positions ADD CONSTRAINT ck_purchase_positions_quantity CHECK (quantity &gt; 0)</sql>
        <createIndex tableName="purchase_positions" indexName="ix_purchase_positions_project">
            <column name="project_id"/>
        </createIndex>
        <createIndex tableName="purchase_positions" indexName="ix_purchase_positions_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="purchase_positions" indexName="ix_purchase_positions_request">
            <column name="purchase_request_id"/>
        </createIndex>
        <createIndex tableName="purchase_positions" indexName="ix_purchase_positions_need_by_date">
            <column name="need_by_date"/>
        </createIndex>
        <createIndex tableName="purchase_positions" indexName="ix_purchase_positions_planned_delivery_date">
            <column name="planned_delivery_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="227-create-purchase-position-variants" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="purchase_position_variants"/></not>
        </preConditions>
        <createTable tableName="purchase_position_variants">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="material_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="unit_sale_price" type="NUMERIC(14,2)"/>
            <column name="unit_planned_purchase_price" type="NUMERIC(14,2)"/>
            <column name="reason" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_purchase_position_variants_position"
            baseTableName="purchase_position_variants" baseColumnNames="position_id"
            referencedTableName="purchase_positions" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint constraintName="fk_purchase_position_variants_material"
            baseTableName="purchase_position_variants" baseColumnNames="material_id"
            referencedTableName="finishing_materials" referencedColumnNames="id"/>
        <createIndex tableName="purchase_position_variants" indexName="ix_purchase_position_variants_position">
            <column name="position_id"/>
        </createIndex>
        <createIndex tableName="purchase_position_variants" indexName="ix_purchase_position_variants_material">
            <column name="material_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
