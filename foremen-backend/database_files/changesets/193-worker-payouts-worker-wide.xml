<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        FOR-07-06 (Requirements 1.3, 1.8, 1.9): make a worker payout worker-wide instead of
        project-scoped.

        FOR-06-11 owned every payout by a project (worker_payouts.project_id NOT NULL, FK
        fk_worker_payouts_project ON DELETE CASCADE, index ix_worker_payouts_project — changeset
        180). FOR-07-06 pays a worker across all projects at once, so:

          - drop index ix_worker_payouts_project, FK fk_worker_payouts_project and the column
            worker_payouts.project_id;
          - add payout_date DATE NOT NULL DEFAULT CURRENT_DATE — the date the payout is issued,
            the month key of the worker's monthly balance chain;
          - add index ix_worker_payouts_worker_date (worker_id, payout_date) for the per-worker,
            per-month reads.

        No data conversion (R1.9): existing payouts keep their rows without a project; their
        payout_date is set to the migration date by the column default.

        Idempotent: the drop runs only while project_id exists (columnExists), the add only while
        payout_date is absent (NOT columnExists), the index only while absent (NOT indexExists),
        each changeSet MARK_RAN. Registered LAST in changelog.xml, after 192.
    -->

    <changeSet id="193-drop-worker-payouts-project" author="foremen">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="worker_payouts" columnName="project_id"/>
        </preConditions>
        <!-- IF EXISTS keeps the drops safe if the index / FK were already removed out of band. -->
        <sql>
            DROP INDEX IF EXISTS ix_worker_payouts_project;
            ALTER TABLE worker_payouts DROP CONSTRAINT IF EXISTS fk_worker_payouts_project;
        </sql>
        <dropColumn tableName="worker_payouts" columnName="project_id"/>
        <rollback>
            <!-- Nullable on rollback: payouts created worker-wide have no project to restore. -->
            <addColumn tableName="worker_payouts">
                <column name="project_id" type="BIGINT"/>
            </addColumn>
            <addForeignKeyConstraint
                constraintName="fk_worker_payouts_project"
                baseTableName="worker_payouts"
                baseColumnNames="project_id"
                referencedTableName="projects"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
            <createIndex tableName="worker_payouts" indexName="ix_worker_payouts_project">
                <column name="project_id"/>
            </createIndex>
        </rollback>
    </changeSet>

    <changeSet id="193-add-worker-payouts-payout-date" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="worker_payouts" columnName="payout_date"/>
            </not>
        </preConditions>
        <!-- Issue date of the payout; defaults to the current date (R1.3). -->
        <addColumn tableName="worker_payouts">
            <column name="payout_date" type="DATE" defaultValueComputed="CURRENT_DATE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="193-index-worker-payouts-worker-date" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="worker_payouts" indexName="ix_worker_payouts_worker_date"/>
            </not>
        </preConditions>
        <!-- Per-worker, per-month payout reads (balance chain, card, advance credit). -->
        <createIndex tableName="worker_payouts" indexName="ix_worker_payouts_worker_date">
            <column name="worker_id"/>
            <column name="payout_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
