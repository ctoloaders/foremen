<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- FOR-06-07 (R11.1, R11.2; entity-creation-rules steps 1-2; design §ABAC seed): seed the
         project-scoped PAYMENTS ABAC resource + its per-role grants. The resource is project-scoped;
         the controller carries @PermissionResource("PAYMENTS") and PaymentScheduleService implements
         ProjectScopedService with getProjectIdPath() = "project.id". The (own) scoping in the matrix
         below (MANAGER/FINANCIER CRUD(own), FOREMAN R(own), CLIENT R(own)) is NOT expressed in the
         ABAC matrix itself — every grant below sits on top of the project-membership filter enforced
         server-side by ProjectScopedService, so the seed grants the full operation set per role and
         ownership restricts the reachable rows to the caller's projects (R11.3).

         Matrix (R11.2):
           ADMIN     -> CREATE, READ, UPDATE, DELETE  (matrix completeness; evaluator bypasses ADMIN)
           MANAGER   -> CREATE, READ, UPDATE, DELETE  (CRUD(own))
           FINANCIER -> CREATE, READ, UPDATE, DELETE  (CRUD(own))
           FOREMAN   -> READ                          (R(own))
           CLIENT    -> READ                          (R(own); client online-pay is a FOR-09 action,
                                                        not a PAYMENTS write)
           WORKER    -> deny-by-default (no grant; see commented placeholder below)
           ESTIMATOR -> deny-by-default (no grant; estimating role, no payment visibility)

         Follows the 017-seed-users-resource.xml / 134-seed-notifications-resource.xml two-changeSet
         resource+grant pattern. Every changeSet is idempotent via an onFail="MARK_RAN" COUNT(*)=0
         precondition AND a per-row NOT EXISTS self-guard, so a re-run against an already-seeded
         database inserts nothing new. Depends on the resources/roles/operations tables (002/003/004).
         Registered LAST in changelog.xml, after 174. -->

    <!-- ChangeSet A: Seed PAYMENTS resource into resources table -->
    <changeSet id="175-seed-payments-resource" author="foremen">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM resources WHERE code = 'PAYMENTS'</sqlCheck>
        </preConditions>

        <insert tableName="resources">
            <column name="code" value="PAYMENTS"/>
            <column name="name_ru" value="Платежи"/>
            <column name="name_pl" value="Płatności"/>
            <column name="description_ru" value="График платежей клиента по проекту и сверка поступлений"/>
            <column name="description_pl" value="Harmonogram płatności klienta w projekcie i uzgadnianie wpłat"/>
        </insert>
    </changeSet>

    <!-- ChangeSet B: Seed the PAYMENTS role matrix. ADMIN / MANAGER / FINANCIER -> full CRUD;
         FOREMAN / CLIENT -> READ only. Role-resource rows and operation rows are both self-guarded by
         a per-row NOT EXISTS so the changeSet is safe to re-run. -->
    <changeSet id="175-seed-payments-permissions" author="foremen">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM role_resources rr
                JOIN resources res ON rr.resource_id = res.id
                WHERE res.code = 'PAYMENTS'
            </sqlCheck>
        </preConditions>

        <!-- role_resources rows for every granted role on PAYMENTS (self-guarded) -->
        <sql>
            INSERT INTO role_resources (role_id, resource_id, created_date, created_by)
            SELECT r.id, res.id, NOW(), 'system'
            FROM roles r, resources res
            WHERE r.code IN ('ADMIN', 'MANAGER', 'FINANCIER', 'FOREMAN', 'CLIENT')
              AND res.code = 'PAYMENTS'
              AND NOT EXISTS (
                  SELECT 1 FROM role_resources rr
                  WHERE rr.role_id = r.id AND rr.resource_id = res.id
              );
        </sql>

        <!-- ADMIN / MANAGER / FINANCIER: full CRUD on PAYMENTS (self-guarded) -->
        <sql>
            INSERT INTO role_resource_operations (role_resource_id, operation_id)
            SELECT rr.id, o.id
            FROM role_resources rr
            JOIN roles r ON rr.role_id = r.id
            JOIN resources res ON rr.resource_id = res.id
            JOIN operations o ON o.code IN ('CREATE', 'READ', 'UPDATE', 'DELETE')
            WHERE r.code IN ('ADMIN', 'MANAGER', 'FINANCIER')
              AND res.code = 'PAYMENTS'
              AND NOT EXISTS (
                  SELECT 1 FROM role_resource_operations rro
                  WHERE rro.role_resource_id = rr.id AND rro.operation_id = o.id
              );
        </sql>

        <!-- FOREMAN / CLIENT: READ only on PAYMENTS (self-guarded) -->
        <sql>
            INSERT INTO role_resource_operations (role_resource_id, operation_id)
            SELECT rr.id, o.id
            FROM role_resources rr
            JOIN roles r ON rr.role_id = r.id
            JOIN resources res ON rr.resource_id = res.id
            JOIN operations o ON o.code = 'READ'
            WHERE r.code IN ('FOREMAN', 'CLIENT')
              AND res.code = 'PAYMENTS'
              AND NOT EXISTS (
                  SELECT 1 FROM role_resource_operations rro
                  WHERE rro.role_resource_id = rr.id AND rro.operation_id = o.id
              );
        </sql>
    </changeSet>

    <!-- WORKER and ESTIMATOR are intentionally omitted (deny-by-default): a WORKER records work but
         never sees client payments, and the ESTIMATOR role has no payment visibility; so no
         role_resources / role_resource_operations row is seeded for either role + PAYMENTS. Left as
         commented placeholders so the deny-by-default decision is explicit:

    <changeSet id="175-seed-payments-permissions-worker" author="foremen">
        ... intentionally NOT seeded: WORKER has no access to PAYMENTS ...
    </changeSet>

    <changeSet id="175-seed-payments-permissions-estimator" author="foremen">
        ... intentionally NOT seeded: ESTIMATOR has no access to PAYMENTS ...
    </changeSet>
    -->

</databaseChangeLog>
