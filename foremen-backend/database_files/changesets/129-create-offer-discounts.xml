<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        FOR-05-07 (Requirements 2.1, 2.2, 4.5): the OfferDiscount — a scoped discount/rebate
        line applied on top of the live-referenced estimate prices.

        Columns mirror OfferDiscountEntity (design §Data Models):
          - offer_id        : owner FK to offers, NOT NULL; ON DELETE CASCADE so deleting an
                              offer removes its discounts. Discount children resolve to a
                              project via offer.project.id (R2.1).
          - scope           : VARCHAR(16) NOT NULL; Discount_Scope { GLOBAL, CATEGORY, LINE }.
          - target_id       : BIGINT NULLABLE; null for GLOBAL, category id for CATEGORY,
                              estimate line id for LINE.
          - kind            : VARCHAR(16) NOT NULL; Discount_Kind { PERCENT, ABSOLUTE }.
          - value           : NUMERIC(14,4) NOT NULL, CHECK value >= 0 (R2.2 — a negative
                              discount value is rejected at the DB level as well as the
                              service layer).
          - source_round_id : BIGINT NULLABLE; the accepted negotiation round that
                              materialized this discount (R4.5). Its FK to
                              offer_negotiation_rounds is DEFERRED to changeset 130 (see the
                              ORDERING NOTE below).
        Plus the four BaseEntity audit columns.

        ORDERING NOTE (source_round FK deferral):
          The source_round FK references offer_negotiation_rounds, which is created in
          changeset 130 (task 1.3), registered AFTER this one. Liquibase applies changesets
          in changelog order, so declaring an addForeignKeyConstraint here (129 -> a table
          that does not yet exist) would FAIL a fresh migrate. Therefore this changeset
          creates ONLY the source_round_id column (BIGINT nullable) and does NOT declare its
          foreign-key constraint. The actual addForeignKeyConstraint
          (offer_discounts.source_round_id -> offer_negotiation_rounds.id, ON DELETE SET
          NULL) MUST be added by changeset 130 AFTER the offer_negotiation_rounds table
          exists. Task 1.3's implementer: add that deferred FK as a step in
          130-create-offer-negotiation-rounds.xml.

        Idempotent via NOT tableExists + MARK_RAN: a re-run against an existing table makes
        no schema change.
    -->

    <changeSet id="129-create-offer-discounts" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="offer_discounts"/>
            </not>
        </preConditions>

        <createTable tableName="offer_discounts">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="offer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="scope" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="BIGINT"/>
            <column name="kind" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="NUMERIC(14,4)">
                <constraints nullable="false"/>
            </column>
            <!-- The accepted round that materialized this discount (R4.5). FK to
                 offer_negotiation_rounds is DEFERRED to changeset 130 (see ORDERING NOTE). -->
            <column name="source_round_id" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <!-- OWNER FK: deleting an offer removes its discounts. -->
        <addForeignKeyConstraint
            constraintName="fk_offer_discounts_offer"
            baseTableName="offer_discounts"
            baseColumnNames="offer_id"
            referencedTableName="offers"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <!-- R2.2: a discount value is never negative. -->
        <sql>
            ALTER TABLE offer_discounts
                ADD CONSTRAINT ck_offer_discounts_value_non_negative CHECK (value >= 0);
        </sql>
        <rollback>
            <sql>
                ALTER TABLE offer_discounts
                    DROP CONSTRAINT IF EXISTS ck_offer_discounts_value_non_negative;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
