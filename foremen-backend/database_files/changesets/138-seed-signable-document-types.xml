    <!--
        FOR-05-08 (R2.3): idempotent seed of the 14 SignableDocumentType rows that match the
        business templates in docs/templates/ (contracts, amendment, handover/acceptance
        protocols, defect form, works-manager statement, room acceptance, key handover).

        Each insert is its own <changeSet> guarded by <preConditions onFail="MARK_RAN"> +
        <sqlCheck expectedResult="0"> on the type code, so a re-run (or a run against a
        database that already seeded a given type) inserts nothing — per-row NOT EXISTS
        idempotency. active defaults to true; name_ru carries the RU i18n value.

        Registered LAST in changelog.xml, AFTER 137 creates the table it seeds.
    -->

    <changeSet id="138-seed-signable-document-type-contract-works" author="foremen">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM signable_document_types WHERE code = 'CONTRACT_WORKS'</sqlCheck>
        </preConditions>
        <insert tableName="signable_document_types">
            <column name="code" value="CONTRACT_WORKS"/>
            <column name="name_pl" value="Umowa o wykonanie prac wykończeniowych"/>
            <column name="name_ru" value="Договор на выполнение отделочных работ"/>
            <column name="active" valueBoolean="true"/>
        </insert>
    </changeSet>

