<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        FOR-06-08 (Requirements 2.1, 7.4): the EstimateAmendment aggregate root — the per-project
        amendment (aneks) that accumulates execution-stage deltas on top of the signed/frozen
        estimate WITHOUT mutating it (design §Data model 1). Its delta lines live in the child
        table amendment_lines (changeset 178).

        estimate_amendments — one row per amendment:
          - id                   : BIGSERIAL PK (BaseEntity).
          - project_id           : owner FK to projects, NOT NULL; ON DELETE CASCADE so deleting a
                                   project removes its amendments (and, transitively, their lines).
                                   Drives the ProjectScopedService project filter
                                   (getProjectIdPath() -> "project.id", R9.1).
          - seq_no               : INT NOT NULL; 1..N per project. UNIQUE (project_id, seq_no).
          - status               : VARCHAR(32) NOT NULL DEFAULT 'OPEN'; the Amendment_Status enum
                                   { OPEN, SENT_FOR_SIGNING, SIGNED, EFFECTIVE, DELETED }. This spec
                                   drives OPEN (and DELETED); the rest are written by FOR-06-09.
          - effective_date       : DATE NULL; unset in this spec — set only by FOR-06-09 on/after
                                   signing (R7.4).
          - signable_document_id : BIGINT NULL FK to signable_documents; unset in this spec — set
                                   only by FOR-06-09. ON DELETE SET NULL.
          - note                 : VARCHAR(1024) NULL; free text, untranslated (R11.3).
        Plus the four BaseEntity audit columns.

        Invariants:
          - UNIQUE (project_id, seq_no) — sequence numbers are per-project.
          - PARTIAL UNIQUE INDEX ux_amendment_open_per_project ON estimate_amendments (project_id)
            WHERE status = 'OPEN' — AT MOST ONE open (unsigned) amendment per project (R2.1).

        Idempotent: the createTable is guarded by NOT tableExists + MARK_RAN, so a re-run against
        an already-migrated database makes no schema change. Registered LAST in changelog.xml,
        after 176.
    -->

    <changeSet id="177-create-estimate-amendments" author="foremen">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="estimate_amendments"/>
            </not>
        </preConditions>

        <createTable tableName="estimate_amendments">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- OWNER FK: deleting a project removes its amendments; drives the project-scope filter. -->
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- 1..N per project; UNIQUE (project_id, seq_no) added below. -->
            <column name="seq_no" type="INT">
                <constraints nullable="false"/>
            </column>
            <!-- Amendment_Status enum; OPEN by default (this spec drives OPEN / DELETED). -->
            <column name="status" type="VARCHAR(32)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
            <!-- Unset in this spec; set only by FOR-06-09 on/after signing (R7.4). -->
            <column name="effective_date" type="DATE"/>
            <!-- Unset in this spec; set only by FOR-06-09. FK + ON DELETE SET NULL below. -->
            <column name="signable_document_id" type="BIGINT"/>
            <!-- Free text, untranslated (R11.3). -->
            <column name="note" type="VARCHAR(1024)"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>

        <!-- OWNER FK: deleting a project removes its amendments (and cascades to amendment_lines). -->
        <addForeignKeyConstraint
            constraintName="fk_estimate_amendments_project"
            baseTableName="estimate_amendments"
            baseColumnNames="project_id"
            referencedTableName="projects"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <!-- Signable document FK (nullable, set by FOR-06-09): clearing the document nulls the ref. -->
        <addForeignKeyConstraint
            constraintName="fk_estimate_amendments_signable_document"
            baseTableName="estimate_amendments"
            baseColumnNames="signable_document_id"
            referencedTableName="signable_documents"
            referencedColumnNames="id"
            onDelete="SET NULL"/>

        <!-- Sequence numbers are per-project. -->
        <addUniqueConstraint
            tableName="estimate_amendments"
            columnNames="project_id, seq_no"
            constraintName="ux_estimate_amendments_project_seq"/>

        <!-- The project-scoped list load of a project's amendments (ProjectScopedService filter). -->
        <createIndex tableName="estimate_amendments" indexName="ix_estimate_amendments_project">
            <column name="project_id"/>
        </createIndex>

        <!-- R2.1: AT MOST ONE open (unsigned) amendment per project — partial unique index. -->
        <sql>
            CREATE UNIQUE INDEX ux_amendment_open_per_project
                ON estimate_amendments (project_id)
                WHERE status = 'OPEN';
        </sql>
        <rollback>
            <sql>
                DROP INDEX IF EXISTS ux_amendment_open_per_project;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
