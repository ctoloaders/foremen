POSTGRES_DB=foremen
POSTGRES_USER=foremen
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Gmail SMTP (mail sender) ---
# Use a Gmail App Password (not the account password) when 2FA is enabled.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-account@gmail.com
MAIL_RESET_BASE_URL=http://localhost:3000/auth/reset-password
MAIL_INVITE_BASE_URL=http://localhost:3000/auth/set-password

# --- Invite token ---
FOREMEN_INVITE_TTL_HOURS=72

# --- Google Places proxy (address autocomplete/details) ---
# When GOOGLE_PLACES_ENABLED=true, GOOGLE_PLACES_API_KEY must be set or startup fails fast.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=

# --- Google Sign-In (FOR-03-10) ---
# OAuth client id (public, "....apps.googleusercontent.com"). Same value for both:
# backend token audience and frontend GIS button (build-time). Blank => disabled.
FOREMEN_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# --- JWT / Admin bootstrap ---
FOREMEN_JWT_SECRET=change-me-to-a-random-32+-byte-secret
FOREMEN_JWT_ACCESS_TTL_MINUTES=30
FOREMEN_JWT_REFRESH_TTL_DAYS=7
FOREMEN_ADMIN_CREATE=false
FOREMEN_ADMIN_EMAIL=admin@example.com
FOREMEN_ADMIN_PASSWORD=change-me

# --- Planning Gantt (FOR-05-10) ---
# Internal Daily_Output_Rate: net estimate value one worker produces per calendar day. Used only by
# auto-create/suggested-duration; never exposed via the API or UI. Must be strictly positive.
FOREMEN_SCHEDULE_DAILY_OUTPUT_PER_WORKER=2000

# --- Bank ledger (FOR-07-04) ---
# Public URL the bank provider returns the user to and posts callbacks to. Required per environment
# (local Docker defaults to http://localhost:3000; Salt Edge needs a public HTTPS URL).
FOREMEN_PUBLIC_BASE_URL=
# Dev/test STUB bank connector (local Docker defaults to true; false on dev VM / production).
FOREMEN_BANK_STUB_ENABLED=
# AES-256-GCM key for per-connection bank credentials: base64 of exactly 32 bytes
# (e.g. `openssl rand -base64 32`). Blank => per-connection credentials unavailable.
FOREMEN_BANK_SECRETS_KEY=

# --- Salt Edge Open Banking (FOR-07-04 bank ledger) ---
# Real values live in .secrets/saltedge.env (git-ignored). Keys: https://www.saltedge.com/clients/api_keys
SALTEDGE_ENABLED=
# PARTNER | CLIENT (default CLIENT)
SALTEDGE_MODE=
# Blank => default for the mode (CLIENT: https://www.saltedge.com/api/v6, PARTNER: .../api/partners/v1)
SALTEDGE_BASE_URL=
SALTEDGE_APP_ID=
SALTEDGE_SECRET=
SALTEDGE_PRIVATE_KEY_PATH=
# Blank => bundled callback verification key
SALTEDGE_CALLBACK_PUBLIC_KEY=
# CLIENT-mode customer identifier (default foremen-company)
SALTEDGE_CUSTOMER_IDENTIFIER=
# PARTNER-mode lead e-mail (required in PARTNER mode)
SALTEDGE_LEAD_EMAIL=
# false => Live (fake providers hidden, HTTPS public base URL required)
SALTEDGE_INCLUDE_FAKE=

# --- Bank transaction AI classifier (FOR-07-04) ---
BANK_AI_ENABLED=
BANK_AI_MODEL=
# Vertex backend (blank project + api-key => Gemini Developer API)
BANK_AI_PROJECT=
BANK_AI_LOCATION=
BANK_AI_API_KEY=
BANK_AI_CREDENTIALS=

# --- Ceneo Partner API (price aggregator, PL) ---
# Obtain a partner API key from Ceneo (http://partnerzyapi.ceneo.pl/).
# Put the real value in a local .env (git-ignored) — never commit it here.
CENEO_API_KEY=2FE150B5-36D5-4784-A1F8-4E7974477398
